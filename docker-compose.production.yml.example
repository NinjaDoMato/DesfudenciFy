# Template — copy to docker-compose.production.yml and fill secrets.
# cp docker-compose.production.yml.example docker-compose.production.yml
# docker compose -f docker-compose.production.yml up --build -d

services:
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: desfudencify
      POSTGRES_USER: desfudencify
      POSTGRES_PASSWORD: CHANGE_ME_STRONG_PASSWORD
    volumes:
      - postgres_data:/var/lib/postgresql/data
    ports:
      # Acesso na LAN para LegacyMigrator / clientes (ex.: 192.168.x.x:5433)
      - "5433:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U desfudencify -d desfudencify"]
      interval: 5s
      timeout: 5s
      retries: 10

  api:
    build:
      context: .
      dockerfile: backend/Dockerfile
    restart: unless-stopped
    environment:
      ASPNETCORE_ENVIRONMENT: Production
      ConnectionStrings__DefaultConnection: Host=postgres;Port=5432;Database=desfudencify;Username=desfudencify;Password=CHANGE_ME_STRONG_PASSWORD
      Jwt__Key: CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
      Jwt__Issuer: DesfudenciFy
      Jwt__Audience: DesfudenciFy
      Jwt__ExpiresHours: "12"
      Seed__AdminEmail: admin@desfudencify.local
      Seed__AdminPassword: CHANGE_ME_ADMIN_PASSWORD
      Seed__AdminFullName: Administrator
      Storage__RootPath: /app/data/uploads
      Logging__LogLevel__Default: Information
      Logging__LogLevel__Microsoft.AspNetCore: Warning
    volumes:
      - ./data/uploads:/app/data/uploads
    ports:
      - "5080:8080"
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:8080/health"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 60s
    depends_on:
      postgres:
        condition: service_healthy

  web:
    build:
      context: .
      dockerfile: frontend/Dockerfile
      args:
        VITE_API_BASE_URL: /api/v1
        VITE_APP_ENV: production
    restart: unless-stopped
    ports:
      - "8080:80"
    depends_on:
      api:
        condition: service_healthy

volumes:
  postgres_data:
