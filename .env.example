# Copy to .env and adjust before deploying to the Raspberry Pi.

POSTGRES_DB=desfudencify
POSTGRES_USER=desfudencify
POSTGRES_PASSWORD=change-me-strong-password

JWT_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=DesfudenciFy
JWT_AUDIENCE=DesfudenciFy
JWT_EXPIRES_HOURS=12

SEED_ADMIN_EMAIL=admin@desfudencify.local
SEED_ADMIN_PASSWORD=ChangeMe@12345
SEED_ADMIN_FULL_NAME=Administrator

# Host ports (access from LAN: http://<raspberry-ip>:8080)
WEB_PORT=8080
API_PORT=5080
